<MudPaper Class="rounded-circle overflow-hidden"
          Style="@($"width: {Size}; height: {Size}; aspect-ratio: 1/1;")"
          Elevation="@Elevation">
    <MudButton Variant="Variant.Text"
               Ripple="@Ripple"
               Class="rounded-circle pa-0"
               Style="width: 100%; height: 100%; position: relative;"
               Disabled="@(!Ripple)"
               @onmouseover="@(() => _hovered = true)"
               @onmouseout="@(() => _hovered = false)"
               OnClick="@OnClick">
        <MudImage Src="@Src"
                  ObjectFit="ObjectFit.Cover"
                  Style="@($"width: 100%; height: 100%; transition: filter 100ms ease; {(_hovered && Ripple ? " filter: blur(3px);" : string.Empty)}")"/>
        @if (_hovered && Ripple) {
            <MudStack Style="position: absolute; inset: 0; background-color: rgba(0,0,0,0.3);"
                      AlignItems="AlignItems.Center"
                      Justify="Justify.Center">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Style="font-size: 64px;"/>
            </MudStack>
        }
    </MudButton>
</MudPaper>

@code {
    [Parameter]
    public string? Src { get; set; } = "https://picsum.photos/1000";

    [Parameter]
    public string? Size { get; set; } = "100%";

    [Parameter]
    public int Elevation { get; set; }

    [Parameter]
    public bool Ripple { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private bool _hovered;
}
