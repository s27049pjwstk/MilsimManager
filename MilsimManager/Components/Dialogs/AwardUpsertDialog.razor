@inject IErrorHandler ErrorHandler
@inject IAwardService AwardService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5">
            @(Award is null ? "Create New Award" : "Edit Award")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Disabled="_disabled">
            <MudTextField @bind-Value="_dto.Name"
                          Label="Name"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="100"
                          Validation="@ValidateNameAsync"
                          Immediate="true"
                          DebounceInterval="300"
                          Required="true"/>
            <MudTextField @bind-Value="_dto.Description"
                          Label="Description"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="1000"
                          AutoGrow="true"
                          Lines="4"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@MudDialog.Cancel">Cancel</MudButton>
        @if (Award is not null) {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       Disabled="_disabled"
                       OnClick="@DeleteAsync">
                Delete
            </MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_disabled" OnClick="@SaveAsync">
            @(Award is null ? "Create" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Award? Award { get; set; }

    public enum Result {
        Created,
        Updated,
        Deleted,
        Failed
    }

    private MudForm _form = null!;
    private bool _disabled;
    private AwardDto _dto = new();

    private sealed class AwardDto {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
    }

    protected override void OnParametersSet() {
        if (Award is null) {
            _dto = new AwardDto();
            return;
        }

        _dto = new AwardDto {
            Name = Award.Name,
            Description = Award.Description
        };
    }

    private async Task<string?> ValidateNameAsync(string? name) {
        if (name is null) return null;
        if (await AwardService.NameExistsAsync(name.Trim(), Award?.Id))
            return "An award with this name already exists";
        return null;
    }

    private async Task SaveAsync() {
        _dto.Name = _dto.Name.Trim();
        _dto.Description = _dto.Description?.Trim();
        await _form.Validate();
        if (!_form.IsValid) return;

        _disabled = true;
        try {
            if (Award is null) {
                var created = await AwardService.CreateAsync(_dto.Name, _dto.Description);
                Snackbar.Add($"Award {created.Name} created", Severity.Success);
                MudDialog.Close(DialogResult.Ok(Result.Created));
            } else {
                var updated = await AwardService.UpdateAsync(Award.Id, Award.Version, _dto.Name, _dto.Description);
                Snackbar.Add($"Award {updated.Name} updated", Severity.Success);
                MudDialog.Close(DialogResult.Ok(Result.Updated));
            }
        } catch (Exception ex) {
            ErrorHandler.HandleException(ex, Award is null ? "Failed to create award" : "Failed to update award");
            MudDialog.Close(DialogResult.Ok(Result.Failed));
        } finally {
            _disabled = false;
        }
    }

    private async Task DeleteAsync() {
        if (Award is null) return;
        var confirm = await DialogService.ShowMessageBox(
        "Delete Award",
        $"Are you sure you want to delete {Award.Name}?",
        "Delete",
        "Cancel",
        options: new DialogOptions { FullWidth = false }
        );

        if (confirm != true) return;

        _disabled = true;
        try {
            await AwardService.DeleteAsync(Award.Id);
            Snackbar.Add("Award deleted", Severity.Success);
            MudDialog.Close(DialogResult.Ok(Result.Deleted));
        } catch (Exception ex) {
            ErrorHandler.HandleException(ex, "Failed to delete award");
            MudDialog.Close(DialogResult.Ok(Result.Failed));
        } finally {
            _disabled = false;
        }
    }
}
