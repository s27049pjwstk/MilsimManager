@page "/users/{UserId:int}"
@attribute [Authorize(Policy = "Active")]
@inject NavigationManager NavigationManager
@inject IUserService UserService
@inject IClipboardService ClipboardService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IAuthorizationService AuthorizationService

@if (_user is null) {
    <MudStack Class="pt-16" AlignItems="AlignItems.Center" Justify="Justify.Center">
        <MudProgressCircular Indeterminate="true"/>
    </MudStack>
} else {
    <MudStack Row="true">
        <MudStack Style="width: 16vw; min-width: 300px; max-width: 400px;">
            <MudPaper Style="background: transparent;" Class="pa-2" Elevation="0">
                <MudAvatar Style="width: 100%; height: 100%; aspect-ratio: 1/1;">
                    <MudIconButton Variant="Variant.Filled" Style="width: 100%; height: 100%; padding: 0;"
                                   Color="Color.Dark" Ripple="@_isSelf" OnClick="@OnEditProfileImageClick">
                        <MudIcon Style="width: 100%; height: 100%;" Icon="@Icons.Material.Rounded.Person"/>
                    </MudIconButton>
                </MudAvatar>
            </MudPaper>

            <MudPaper Class="py-1" Elevation="2">
                @*todo edit button for user rank*@
                @*todo navigation to rank page*@
                <MudText Typo="Typo.caption" Class="px-2 mud-text-secondary">Rank</MudText>


                <MudDivider/>
                <MudStack Row="true">
                    <MudStack Class="d-flex flex-grow-1 px-2 py-1" AlignItems="AlignItems.Center"
                              Justify="Justify.Center" Spacing="0">
                        <MudText Align="Align.Center" Typo="Typo.h6">@_user.Rank?.Name</MudText>
                        <MudText Typo="Typo.body2">
                            @if (!string.IsNullOrWhiteSpace(_user.Rank?.Code)) {
                                @_user.Rank.Code
                                @if (!string.IsNullOrWhiteSpace(_user.Rank.Abbreviation)) {
                                    @(" | ")
                                }
                            }
                            @_user?.Rank?.Abbreviation
                        </MudText>
                    </MudStack>
                    <AuthorizeView Policy="Admin">
                        <MudStack Class="justify-center pa-2">
                            <MudIconButton Class="pa-2" Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                           OnClick="@OnRankEditClick"/>
                            @*todo this button like this or instead a button fullwidth under the whole rank mudpaper*@
                        </MudStack>
                    </AuthorizeView>
                </MudStack>

            </MudPaper>
            <MudPaper Class="py-1" Elevation="2">
                <MudText Typo="Typo.caption" Class="px-2 mud-text-secondary">Assignment</MudText>
                <MudDivider/>
                <MudButton FullWidth="true" Variant="Variant.Text" Ripple="false"
                           Class="justify-start rounded-0  cursor-default"
                           OnClick="@(() => NavigationManager.Refresh())">
                    <MudText Align="Align.Left" Style="line-height: 1.2;" Typo="Typo.body1">
                        <b>Status</b><br/>
                        @_user.Status
                    </MudText>
                    <MudSpacer/>
                    @if (_isAdmin || _isSelf) {
                        <MudIconButton Class="pa-2" Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                       OnClick="@OnEditStatusClick"/>
                    }
                </MudButton>
                <MudButton FullWidth="true" Variant="Variant.Text" Class="justify-start rounded-0"
                           Ripple="@(_user.Unit is not null)"
                           OnClick="@(() => {
                                        if (_user.Unit is null) return;
                                        NavigationManager.NavigateTo($"/units/{_user.Unit.Id}");
                                    })">
                    <MudStack Spacing="1">
                        @if (_user.Unit is not null) {
                            <MudText Align="Align.Left" Class="pb-2" Style="line-height: 1.2;" Typo="Typo.body1">
                                <b>Unit</b><br/>
                                @(_user.Unit?.Name ?? "Unassigned")
                            </MudText>
                        }
                        <MudText Align="Align.Left" Style="line-height: 1.2;" Typo="Typo.body1">
                            <b>Position</b><br/>
                            @(_user.UnitRole ?? "None")
                        </MudText>
                    </MudStack>
                    <MudSpacer/>
                    <AuthorizeView Policy="Admin">
                        <MudIconButton Class="pa-2" Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                       OnClick="@OnEditAssignmentClick"/>
                    </AuthorizeView>
                </MudButton>
            </MudPaper>
            <MudPaper Class="py-1" Elevation="2">
                <MudText Typo="Typo.caption" Class="px-2 mud-text-secondary">Information</MudText>
                <MudDivider/>
                <MudButton FullWidth="true" Ripple="true" Variant="Variant.Text"
                           Class="justify-start rounded-0 cursor-default"
                           OnClick="@(() => ClipboardService.CopyToClipboard(_user.DateJoined.ToDiscordTimestamp()))">
                    <MudText Align="Align.Left" Style="line-height: 1.2;" Typo="Typo.body1">
                        <b>Joined</b><br/>
                        @_user.DateJoined.ToLocalTime().ToString("d") <i>@_user.DateJoined.ToLocalTime().TimeAgo()</i>
                    </MudText>
                </MudButton>
                <MudButton FullWidth="true" Variant="Variant.Text" Class="justify-start rounded-0"
                           OnClick="@(() => ClipboardService.CopyToClipboard(_user.SteamId))">
                    <MudText Align="Align.Left" Style="line-height: 1.2;" Typo="Typo.body1">
                        <b>SteamID64</b><br/>
                        @(_user.SteamId ?? "None")
                    </MudText>
                    <MudSpacer/>
                    @if (_isAdmin || _isSelf) {
                        <MudIconButton Class="pa-2" Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                       OnClick="@OnEditSteamIdClick"/>
                    }
                </MudButton>
                <MudButton FullWidth="true" Ripple="@(_user.DiscordId is not null)" Variant="Variant.Text"
                           Class="justify-start rounded-0"
                           OnClick="@(() => ClipboardService.CopyToClipboard(_user.DiscordId))">
                    <MudText Align="Align.Left" Style="line-height: 1.2;" Typo="Typo.body1">
                        <b>Discord ID</b><br/>
                        @(_user.DiscordId ?? "None")
                    </MudText>
                    <MudSpacer/>
                    @if (_user.DiscordId is not null) {
                        <MudIcon Color="Color.Default" Size="Size.Small" Class="mr-2"
                                 Icon="@Icons.Material.Rounded.ContentCopy"/>
                    }
                </MudButton>
            </MudPaper>
            <MudPaper Class="py-1" Elevation="2">
                <MudText Typo="Typo.caption" Class="px-2 mud-text-secondary">Certifications</MudText>
                <MudDivider/>
                @if (_certifications.Count == 0) {
                    <MudText Typo="Typo.body2" Class="px-2 pt-1 mud-text-secondary">None</MudText>
                } else {
                    <MudList T="string" Dense="true">
                        @foreach (var cert in _certifications) {
                            <MudListItem T="string" Class="px-2 py-0" Href="@($"/certifications/{cert}")">
                                @cert
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudPaper>
            <AuthorizeView Policy="Admin">
                <MudPaper Class="py-1" Elevation="2">
                    @*todo add a way to edit admin note*@
                    <MudText Typo="Typo.caption" Class="px-2 mud-text-secondary">Admin Note</MudText>
                    <MudDivider/>
                    @if (string.IsNullOrWhiteSpace(_user.Note)) {
                        <MudText Typo="Typo.body2" Class="px-2 pt-1 mud-text-secondary">None</MudText>
                    } else {
                        <MudText Typo="Typo.body2" Class="px-2 pt-1">@_user.Note</MudText>
                    }
                </MudPaper>
            </AuthorizeView>
        </MudStack>
        <MudStack Style="flex: 1 1 0; min-width: 300px;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudText Class="py-6" Typo="Typo.h2">@_user?.Name</MudText>
                <MudChip T="string" Size="Size.Large" Color="@GetStatusColor(_user.Status)">
                    @_user.Status
                </MudChip>
            </MudStack>
            <MudPaper Class="pa-2">
                <MudTabs Rounded="true" Elevation="0">
                    <MudTabPanel Text="Awards">
                        <MudTable Items="@(_user.UserAwards.OrderByDescending(x => x.Date))"
                                  Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Award</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Date">@context.Date.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                                @*todo add award images*@
                                <MudTd DataLabel="Award">@context.Award.Name</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Class="pa-4 mud-text-secondary">None</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>
                    @*todo add maybe later filtering/sorting using https://mudblazor.com/components/datagrid#default-data-grid*@
                    @*todo add search func maybe?*@
                    <MudTabPanel Text="Events">
                        <MudTable Items="@(_user.UserAttendances.OrderByDescending(x => x.Event.Date))"
                                  Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Event</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Date">@context.Event.Date.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                                <MudTd DataLabel="Event">@context.Event.Name</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Class="pa-4 mud-text-secondary">None</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>
                    <MudTabPanel Text="Ranks">
                        <MudTable Items="@_user.RankLogs.OrderByDescending(x => x.Date)"
                                  Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Rank</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Date">@context.Date.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                                <MudTd DataLabel="Rank">@(context.Rank?.Name ?? context.RankName)</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Class="pa-4 mud-text-secondary">None</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>

                    <MudTabPanel Text="Assignments">
                        <MudTable Items="@_user.UnitAssignmentLogs.OrderByDescending(x => x.Date)"
                                  Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Unit</MudTh>
                                <MudTh>Position</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Date">@context.Date.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                                <MudTd DataLabel="Unit">@(context.Unit?.Name ?? context.UnitName)</MudTd>
                                <MudTd DataLabel="Position">@context.Role</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Class="pa-4 mud-text-secondary">None</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>

                    <MudTabPanel Text="Certifications">
                        <MudTable Items="@_user.UserCertifications.OrderByDescending(x => x.Date)"
                                  Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Certification</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Date">@context.Date.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                                <MudTd DataLabel="Certification">@context.Certification.Name</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Class="pa-4 mud-text-secondary">None</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </MudStack>
    </MudStack>
}


@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;
    private bool _isSelf;
    private bool _isAdmin;
    private bool _noUser;

    [Parameter]
    public int UserId { get; set; }

    private User? _user;
    private List<string> _certifications = [];

    protected override async Task OnParametersSetAsync() {
        _user = await UserService.GetByIdAsync(UserId);
        if (_user is null) {
            _noUser = true;
            return;
        }
        var authState = await AuthenticationStateTask;
        _isSelf = authState.User.FindFirstValue("auth_UserId") == UserId.ToString();
        _isAdmin = (await AuthorizationService.AuthorizeAsync(authState.User, policyName: "Admin")).Succeeded;

        _certifications = _user.UserCertifications
            .Select(x => x.Certification.Name)
            .ToList();
    }

    protected override void OnAfterRender(bool firstRender) {
        if (!_noUser) return;
        _noUser = false;
        Snackbar.Add("User does not exist", Severity.Error);
        NavigationManager.NavigateTo("/users", false, true);
    }

    private static Color GetStatusColor(string? status) => status switch {
        "LOA" => Color.Primary, "Active" => Color.Success, _ => Color.Dark
    };//todo move this to model or a extension later?

    private async Task OnEditAssignmentClick() {
        if (_user is null) return;

        var dialog = await DialogService.ShowAsync<UserAssignmentDialog>("", new DialogParameters { ["User"] = _user });
        var result = await dialog.Result;
        if (!(result?.Canceled ?? true)) _user = await UserService.GetByIdAsync(_user.Id);
    }
    private void OnEditProfileImageClick() {
        if (!_isSelf) return;
        Snackbar.Add("Not implemented", Severity.Warning);
        //todo NotImplemented
    }

    private void OnEditStatusClick() {
        Snackbar.Add("Not implemented", Severity.Warning);
        //todo NotImplemented
    }
    private void OnEditSteamIdClick() {
        Snackbar.Add("Not implemented", Severity.Warning);
        //todo NotImplemented
    }
}
