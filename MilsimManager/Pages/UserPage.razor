@page "/users/{UserId:int}"
@attribute [Authorize(Policy = "Active")]
@inject NavigationManager NavigationManager
@inject IUserService UserService
@inject IClipboardService ClipboardService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IAuthorizationService AuthorizationService
@inject IErrorHandler ErrorHandler
@inject ICertificationService CertificationService
@inject IAwardService AwardService

@if (_user is null) {
    <MudStack Class="pt-16" AlignItems="AlignItems.Center" Justify="Justify.Center">
        <MudProgressCircular Indeterminate="true"/>
    </MudStack>
} else {
    <MudStack Row="true" Spacing="4">
        <MudStack Style="width: 16vw; min-width: 300px; max-width: 400px;">
            <ProfileImageButton Src="@PlaceholderImageExtensions.GetImageUrl($"user-{UserId}")" Elevation="2"
                                Ripple="@(_isSelf || _isAdmin)"
                                OnClick="@OnEditProfileImageClick"/>

            <MudPaper Class="py-1" Elevation="2">
                <MudText Typo="Typo.caption" Class="px-2 mud-text-secondary">Rank</MudText>
                <MudDivider/>
                <MudButton FullWidth="true" Variant="Variant.Text" Class="pa-0 justify-start rounded-0"
                           Ripple="@(_user.Rank is not null)"
                           OnClick="@(() => {
                                        if (_user.Rank is not null) NavigationManager.NavigateTo($"/ranks/{_user.Rank.Id}");
                                    })">
                    <MudStack Row="true" Class="flex-grow-1">
                        <MudStack Class="d-flex flex-grow-1 px-2 py-1" AlignItems="AlignItems.Center"
                                  Justify="Justify.Center" Spacing="0">
                            <MudText Align="Align.Center" Typo="Typo.h6">@_user.Rank?.Name</MudText>
                            <MudText Typo="Typo.body2">
                                @if (!string.IsNullOrWhiteSpace(_user.Rank?.Code)) {
                                    @_user.Rank.Code
                                    @if (!string.IsNullOrWhiteSpace(_user.Rank.Abbreviation)) {
                                        @(" | ")
                                    }
                                }
                                @_user?.Rank?.Abbreviation
                            </MudText>
                        </MudStack>
                        <AuthorizeView Policy="Admin">
                            <MudStack Class="justify-center pa-2">
                                <MudIconButton Class="pa-2" Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                               OnClick="@OnEditRankClick"/>
                            </MudStack>
                        </AuthorizeView>
                    </MudStack>
                </MudButton>

            </MudPaper>
            <MudPaper Class="py-1" Elevation="2">
                <MudText Typo="Typo.caption" Class="px-2 mud-text-secondary">Assignment</MudText>
                <MudDivider/>
                <MudButton FullWidth="true" Variant="Variant.Text" Ripple="false"
                           Class="justify-start rounded-0 cursor-default">
                    <MudText Align="Align.Left" Style="line-height: 1.2;" Typo="Typo.body1">
                        <b>Status</b><br/>
                        @_user.Status
                    </MudText>
                    <MudSpacer/>
                    @if (_isAdmin) {
                        <MudIconButton Class="pa-2 ml-1"
                                       Size="Size.Small"
                                       Disabled="@_statusUpdateDisabled"
                                       Icon="@Icons.Material.Filled.Cached"
                                       OnClick="@OnToggleActiveClick"/>
                    }
                </MudButton>
                <MudButton FullWidth="true" Variant="Variant.Text" Class="justify-start rounded-0"
                           Ripple="@(_user.Unit is not null)"
                           OnClick="@(() => {
                                        if (_user.Unit is null) return;
                                        NavigationManager.NavigateTo($"/units/{_user.Unit.Id}");
                                    })">
                    <MudStack Spacing="1">
                        @if (_user.Unit is not null) {
                            <MudText Align="Align.Left" Class="pb-2" Style="line-height: 1.2;" Typo="Typo.body1">
                                <b>Unit</b><br/>
                                @(_user.Unit?.Name ?? "Unassigned")
                            </MudText>
                        }
                        <MudText Align="Align.Left" Style="line-height: 1.2;" Typo="Typo.body1">
                            <b>Position</b><br/>
                            @(_user.UnitRole ?? "None")
                        </MudText>
                    </MudStack>
                    <MudSpacer/>
                    <AuthorizeView Policy="Admin">
                        <MudIconButton Class="pa-2" Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                       OnClick="@OnEditAssignmentClick"/>
                    </AuthorizeView>
                </MudButton>
            </MudPaper>
            <MudPaper Class="py-1" Elevation="2">
                <MudText Typo="Typo.caption" Class="px-2 mud-text-secondary">Information</MudText>
                <MudDivider/>
                <MudButton FullWidth="true" Ripple="true" Variant="Variant.Text"
                           Class="justify-start rounded-0 cursor-default"
                           OnClick="@(() => ClipboardService.CopyToClipboard(_user.DateJoined.ToDiscordTimestamp()))">
                    <MudText Align="Align.Left" Style="line-height: 1.2;" Typo="Typo.body1">
                        <b>Joined</b><br/>
                        @_user.DateJoined.ToLocalTime().ToString("d") <i>@_user.DateJoined.ToLocalTime().TimeRelative()</i>
                    </MudText>
                </MudButton>
                <MudButton FullWidth="true" Variant="Variant.Text" Class="justify-start rounded-0"
                           OnClick="@(() => ClipboardService.CopyToClipboard(_user.SteamId))">
                    <MudText Align="Align.Left" Style="line-height: 1.2;" Typo="Typo.body1">
                        <b>SteamID64</b><br/>
                        @(_user.SteamId ?? "None")
                    </MudText>
                    <MudSpacer/>
                    @if (_isAdmin || _isSelf) {
                        <MudIconButton Class="pa-2" Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                       OnClick="@OnEditSteamIdClick"/>
                    }
                </MudButton>
                <MudButton FullWidth="true" Ripple="@(_user.DiscordId is not null)" Variant="Variant.Text"
                           Class="justify-start rounded-0"
                           OnClick="@(() => ClipboardService.CopyToClipboard(_user.DiscordId))">
                    <MudText Align="Align.Left" Style="line-height: 1.2;" Typo="Typo.body1">
                        <b>Discord ID</b><br/>
                        @(_user.DiscordId ?? "None")
                    </MudText>
                    <MudSpacer/>
                    @if (_user.DiscordId is not null) {
                        <MudIcon Color="Color.Default" Size="Size.Small" Class="mr-2"
                                 Icon="@Icons.Material.Rounded.ContentCopy"/>
                    }
                </MudButton>
            </MudPaper>
            <MudPaper Class="py-1" Elevation="2">
                <MudText Typo="Typo.caption" Class="px-2 mud-text-secondary">Certifications</MudText>
                <MudDivider/>
                @if (_certifications.Count == 0) {
                    <MudText Typo="Typo.body2" Class="px-2 pt-1 mud-text-secondary">None</MudText>
                } else {
                    <MudList T="Certification" Dense="true">
                        @foreach (var cert in _certifications) {
                            <MudListItem T="Certification" Class="px-2 py-0" Href="@($"/certifications/{cert.Id}")">
                                @cert.Name
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudPaper>
            <AuthorizeView Policy="Admin">
                <MudPaper Class="py-1" Elevation="2">
                    <MudText Typo="Typo.caption" Class="px-2 mud-text-secondary">Admin Note</MudText>
                    <MudDivider/>
                    <MudTextField @bind-Value="@_adminNoteText"
                                  @ref="_adminNote"
                                  Class="px-2"
                                  Placeholder="None"
                                  Typo="Typo.body2"
                                  Underline="false"
                                  Variant="Variant.Text"
                                  AutoGrow="true"
                                  Immediate="true"
                                  Disabled="@_adminNoteDisabled"
                                  OnKeyDown="@OnEditAdminNoteCancel"
                                  OnBlur="@OnEditAdminNoteSaveAsync"
                                  MaxLength="1000"
                    />
                </MudPaper>
            </AuthorizeView>
        </MudStack>
        <MudStack Style="flex: 1 1 0; min-width: 300px;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudText Class="py-6" Typo="Typo.h2">@_user?.Name</MudText>
                <MudChip T="string" Size="Size.Large" Color="@GetStatusColor(_user.Status)">
                    @_user.Status
                </MudChip>
            </MudStack>
            <MudPaper Class="pa-2">
                <MudTabs Rounded="true" Elevation="0">
                    <MudTabPanel Text="Awards">
                        <MudTable T="UserAward"
                                  Items="@_user.UserAwards.OrderByDescending(x => x.Date)"
                                  Dense="true" Hover="true" Elevation="0"
                                  RowClass="cursor-pointer"
                                  OnRowClick="@OnAwardRowClick">
                            <ColGroup>
                                <col style="width: 120px;"/>
                                <col style="width: 40%;"/>
                                <col style="width: 40%;"/>
                                <col style="width: 10%;"/>
                            </ColGroup>
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Award</MudTh>
                                <MudTh>Approved by</MudTh>
                                <MudTh/>
                            </HeaderContent>
                            <RowTemplate Context="userAward">
                                <MudTd DataLabel="Date">@userAward.Date.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                                <MudTd DataLabel="Award">@userAward.Award.Name</MudTd>
                                <MudTd DataLabel="Approved by">@userAward.ApprovedByName</MudTd>
                                <MudTd Class="d-flex justify-end gap-2">
                                    @if (!string.IsNullOrWhiteSpace(userAward.Comment)) {
                                        <MudIconButton Class="pa-2" Size="Size.Small"
                                                       Icon="@Icons.Material.Filled.Comment"
                                                       OnClick="@(() => ShowAwardComment(userAward))"/>
                                    }
                                    <AuthorizeView Policy="Admin">
                                        <MudIconButton Class="pa-2" Size="Size.Small"
                                                       Icon="@Icons.Material.Filled.Delete"
                                                       OnClick="@(() => OnRemoveUserAwardClick(userAward))"/>
                                    </AuthorizeView>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Class="pa-4 mud-text-secondary">None</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>
                    <MudTabPanel Text="Events">
                        <MudTable T="UserAttendance"
                                  Items="@(_user.UserAttendances.OrderByDescending(x => x.Event.Date))"
                                  Dense="true" Hover="true" Elevation="0"
                                  RowClass="cursor-pointer"
                                  OnRowClick="@OnEventRowClick">
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Event</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Date">@context.Event.Date.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                                <MudTd DataLabel="Event">@context.Event.Name</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Class="pa-4 mud-text-secondary">None</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>
                    <MudTabPanel Text="Ranks">
                        <MudTable T="RankLog"
                                  Items="@_user.RankLogs.OrderByDescending(x => x.Date)"
                                  Dense="true" Hover="true" Elevation="0"
                                  RowClass="cursor-pointer"
                                  OnRowClick="@OnRankRowClick">
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Rank</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Date">@context.Date.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                                <MudTd DataLabel="Rank">@(context.Rank?.Name ?? context.RankName)</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Class="pa-4 mud-text-secondary">None</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>

                    <MudTabPanel Text="Assignments">
                        <MudTable T="UnitAssignmentLog"
                                  Items="@_user.UnitAssignmentLogs.OrderByDescending(x => x.Date)"
                                  Dense="true" Hover="true" Elevation="0"
                                  RowClass="cursor-pointer"
                                  OnRowClick="@OnAssignmentRowClick">
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Unit</MudTh>
                                <MudTh>Position</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Date">@context.Date.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                                <MudTd DataLabel="Unit">@(context.Unit?.Name ?? context.UnitName)</MudTd>
                                <MudTd DataLabel="Position">@context.Role</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Class="pa-4 mud-text-secondary">None</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>

                    <MudTabPanel Text="Certifications">
                        <MudTable T="UserCertification"
                                  Items="@_user.UserCertifications.OrderBy(x => x.Certification.Name)"
                                  Dense="true" Hover="true" Elevation="0"
                                  RowClass="cursor-pointer"
                                  OnRowClick="@OnCertificationRowClick">
                            <ColGroup>
                                <col style="width: 120px;"/>
                                <col style="width: 40%;"/>
                                <col style="width: 40%;"/>
                                <col style="width: 10%;"/>
                            </ColGroup>
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Certification</MudTh>
                                <MudTh>Approved by</MudTh>
                                <MudTh/>
                            </HeaderContent>
                            <RowTemplate Context="userCert">
                                <MudTd DataLabel="Date">@userCert.Date.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                                <MudTd DataLabel="Certification">@userCert.Certification.Name</MudTd>
                                <MudTd DataLabel="Approved by">@userCert.ApprovedByName</MudTd>
                                <MudTd Class="d-flex justify-end gap-2">
                                    @if (!string.IsNullOrWhiteSpace(userCert.Comment)) {
                                        <MudIconButton Class="pa-2" Size="Size.Small"
                                                       Icon="@Icons.Material.Filled.Comment"
                                                       OnClick="@(() => ShowCertificationComment(userCert))"/>
                                    }
                                    <AuthorizeView Policy="Admin">
                                        <MudIconButton Class="pa-2" Size="Size.Small"
                                                       Icon="@Icons.Material.Filled.Delete"
                                                       OnClick="@(() => OnRemoveUserCertificationClick(userCert))"/>
                                    </AuthorizeView>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Class="pa-4 mud-text-secondary">None</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </MudStack>
    </MudStack>
}


@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;
    private bool _isSelf;
    private bool _isAdmin;
    private bool _noUser;
    private bool _statusUpdateDisabled;

    private MudTextField<string> _adminNote = null!;
    private string? _adminNoteText;
    private bool _adminNoteDisabled;

    [Parameter]
    public int UserId { get; set; }

    private User? _user;
    private List<Certification> _certifications = [];

    protected override async Task OnParametersSetAsync() {
        await RefreshUserAsync();
        if (_user is null) return;
        var authState = await AuthenticationStateTask;
        _isSelf = authState.User.FindFirstValue("auth_UserId") == UserId.ToString();
        _isAdmin = (await AuthorizationService.AuthorizeAsync(authState.User, policyName: "Admin")).Succeeded;
    }

    protected override void OnAfterRender(bool firstRender) {
        if (!_noUser) return;
        _noUser = false;
        Snackbar.Add("User does not exist", Severity.Error);
        NavigationManager.NavigateTo("/users", false, true);
    }

    private static Color GetStatusColor(string? status) => status switch {
        "LOA" => Color.Primary, "Active" => Color.Success, _ => Color.Dark
    };

    private async Task OnEditAssignmentClick() {
        if (_user is null) return;

        var dialog = await DialogService.ShowAsync<UserAssignmentDialog>("", new DialogParameters { ["User"] = _user });
        var result = await dialog.Result;
        if (result?.Data is User updated) {
            SetUser(updated);
        } else if (!(result?.Canceled ?? true)) {
            await RefreshUserAsync();
        }
    }

    private async Task ShowCertificationComment(UserCertification userCertification) {
        if (string.IsNullOrWhiteSpace(userCertification.Comment)) return;
        await DialogService.ShowMessageBox(
        $"Comment for {userCertification.Certification.Name}",
        userCertification.Comment
        );
    }

    private void OnCertificationRowClick(TableRowClickEventArgs<UserCertification> args) =>
        NavigationManager.NavigateTo($"/certifications/{args.Item?.CertificationId}");

    private async Task ShowAwardComment(UserAward userAward) {
        if (string.IsNullOrWhiteSpace(userAward.Comment)) return;
        await DialogService.ShowMessageBox(
        $"Comment for {userAward.Award.Name}",
        userAward.Comment
        );
    }

    private void OnAwardRowClick(TableRowClickEventArgs<UserAward> args) =>
        NavigationManager.NavigateTo($"/awards/{args.Item?.AwardId}");

    private void OnEventRowClick(TableRowClickEventArgs<UserAttendance> args) =>
        NavigationManager.NavigateTo($"/events/{args.Item?.EventId}");

    private void OnRankRowClick(TableRowClickEventArgs<RankLog> args) {
        if (args.Item?.RankId is null) return;
        NavigationManager.NavigateTo($"/ranks/{args.Item.RankId}");
    }

    private void OnAssignmentRowClick(TableRowClickEventArgs<UnitAssignmentLog> args) {
        if (args.Item?.UnitId is null) return;
        NavigationManager.NavigateTo($"/units/{args.Item.UnitId}");
    }

    private async Task OnRemoveUserCertificationClick(UserCertification userCertification) {
        if (_user is null) return;
        var confirm = await DialogService.ShowMessageBox(
        "Remove certification",
        $"Remove {userCertification.Certification.Name} from {_user.Name}?",
        "Remove",
        "Cancel",
        options: new DialogOptions { FullWidth = false }
        );

        if (confirm != true) return;

        try {
            await CertificationService.RemoveUserAsync(userCertification.CertificationId, _user.Id);
            Snackbar.Add("Certification removed", Severity.Success);
        } catch (Exception ex) {
            ErrorHandler.HandleException(ex, "Failed to remove certification");
        } finally {
            await RefreshUserAsync();
        }
    }

    private async Task OnRemoveUserAwardClick(UserAward userAward) {
        if (_user is null) return;
        var confirm = await DialogService.ShowMessageBox(
        "Remove award",
        $"Remove {userAward.Award.Name} from {_user.Name}?",
        "Remove",
        "Cancel",
        options: new DialogOptions { FullWidth = false }
        );

        if (confirm != true) return;

        try {
            await AwardService.RemoveUserAsync(userAward.AwardId, _user.Id);
            Snackbar.Add("Award removed", Severity.Success);
        } catch (Exception ex) {
            ErrorHandler.HandleException(ex, "Failed to remove award");
        } finally {
            await RefreshUserAsync();
        }
    }

    private async Task RefreshUserAsync() => SetUser(await UserService.GetByIdAsync(UserId));

    private void SetUser(User? user) {
        _user = user;
        if (_user is null) {
            _noUser = true;
            _certifications = [];
            _adminNoteText = null;
            return;
        }
        _noUser = false;
        _adminNoteText = _user.Note;
        _certifications = _user.UserCertifications
            .Select(x => x.Certification)
            .OrderBy(x => x.Name)
            .ToList();
    }

    private void OnEditProfileImageClick() {
        if (!_isSelf) return;
        Snackbar.Add("Not implemented", Severity.Warning);
    }

    private async Task OnToggleActiveClick() {
        if (_user is null || _statusUpdateDisabled) return;
        _statusUpdateDisabled = true;
        try {
            var approver = await UserService.GetAuthenticatedUserAsync(AuthenticationStateTask);
            var newStatus = !_user.Active;
            _user.Version = await UserService.UpdateStatusAsync(_user.Id, _user.Version, newStatus, approver);
            _user.Active = newStatus;
            Snackbar.Add($"Status set to {(_user.Active ? "Active" : "Inactive")}", Severity.Success);
        } catch (Exception ex) {
            ErrorHandler.HandleException(ex, "Failed to update status");
            await RefreshUserAsync();
        } finally {
            _statusUpdateDisabled = false;
        }
    }

    private async Task OnEditSteamIdClick() {
        if (_user is null) return;
        var dialog = await DialogService.ShowAsync<UserSteamIdDialog>("", new DialogParameters { ["User"] = _user });
        var result = await dialog.Result;
        if (result?.Data is User updated) {
            SetUser(updated);
        } else if (!(result?.Canceled ?? true)) {
            await RefreshUserAsync();
        }
    }
    private async Task OnEditRankClick() {
        if (_user is null) return;
        var dialog = await DialogService.ShowAsync<UserRankDialog>("", new DialogParameters { ["User"] = _user });
        var result = await dialog.Result;
        if (result?.Data is User updated) {
            SetUser(updated);
        } else if (!(result?.Canceled ?? true)) {
            await RefreshUserAsync();
        }
    }
    private async Task OnEditAdminNoteSaveAsync() {
        if (_user is null || _adminNoteDisabled) return;
        _adminNoteText = string.IsNullOrWhiteSpace(_adminNoteText) ? null : _adminNoteText.Trim();
        if (_adminNoteText == _user.Note) {
            await _adminNote.SetText(_adminNoteText ?? string.Empty);
            return;
        }
        try {
            _adminNoteDisabled = true;
            _user.Version = await UserService.UpdateNoteAsync(_user.Id, _user.Version, _adminNoteText);
            _user.Note = _adminNoteText;
            Snackbar.Add("Saved", Severity.Success);
            _adminNoteText = _user.Note;
        } catch (Exception ex) {
            ErrorHandler.HandleException(ex, "Failed to save admin note");
        } finally {
            await _adminNote.SetText(_adminNoteText ?? string.Empty);
            _adminNoteDisabled = false;
        }
    }

    private async Task OnEditAdminNoteCancel(KeyboardEventArgs e) {
        if (e.Key != "Escape") return;
        _adminNoteDisabled = true;
        _adminNoteText = _user?.Note;
        await _adminNote.BlurAsync();
        await _adminNote.SetText(_user?.Note ?? string.Empty);
        Snackbar.Add("Cancel");
        _adminNoteDisabled = false;
    }
}
