@page "/certifications"
@attribute [Authorize(Policy = "Active")]
@inject NavigationManager NavigationManager
@inject ICertificationService CertificationService
@inject IDialogService DialogService

<MudStack Spacing="2">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.FlexStart">
        <MudButton Class="pa-1" Variant="Variant.Filled" Size="Size.Medium">
            <MudTextField @bind-Value="_search"
                          Placeholder="Search..."
                          Immediate="true"
                          DebounceInterval="300"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true"
                          AutoFocus="true"
                          Underline="false"/>
        </MudButton>
        <AuthorizeView Policy="Admin">
            <MudButton Variant="Variant.Filled" Size="Size.Medium" OnClick="@OpenCreateDialog">
                Create New Certification
            </MudButton>
        </AuthorizeView>
    </MudStack>

    <MudTable T="Certification"
              Items="_certifications"
              Filter="FilterCertifications"
              Hover="true"
              Dense="true"
              Loading="_loading"
              RowClass="cursor-pointer"
              OnRowClick="OnRowClick">
        <ColGroup>
            <col style="width: 72px;"/>
        </ColGroup>
        <HeaderContent>
            <MudTh>Certifications</MudTh>
            <MudTh/>
        </HeaderContent>

        <RowTemplate>
            <MudTd Class="d-flex align-center pa-3">
                <MudImage Class="rounded" Src="@PlaceholderImageExtensions.GetImageUrl($"certification-{context.Id}")" Width="100" Height="100"
                          ObjectFit="ObjectFit.Cover"/>
            </MudTd>
            <MudTd DataLabel="Name">
                <MudText Typo="Typo.h5">@context.Name</MudText>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText>No certifications found.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudStack>

@code {
    private List<Certification> _certifications = [];
    private bool _loading;
    private string? _search;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync() {
        _loading = true;
        try {
            _certifications = await CertificationService.GetAllAsync();
        } finally {
            _loading = false;
        }
    }

    private void OnRowClick(TableRowClickEventArgs<Certification> args) {
        if (_loading) return;
        NavigationManager.NavigateTo($"/certifications/{args.Item?.Id}");
    }

    private bool FilterCertifications(Certification certification) {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var term = _search.Trim();
        return certification.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
               (certification.Description?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private async Task OpenCreateDialog() {
        var dialog = await DialogService.ShowAsync<CertificationUpsertDialog>("");
        var result = await dialog.Result;
        if (!(result?.Canceled ?? true)) await ReloadAsync();
    }
}
