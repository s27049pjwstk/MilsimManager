@page "/events"
@attribute [Authorize(Policy = "Active")]
@inject NavigationManager NavigationManager
@inject IEventService EventService
@inject IDialogService DialogService

<MudStack Spacing="2">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.FlexStart">
        <MudButton Class="pa-1" Variant="Variant.Filled" Size="Size.Medium">
            <MudTextField @bind-Value="_search"
                          Placeholder="Search..."
                          Immediate="true"
                          DebounceInterval="300"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true"
                          AutoFocus="true"
                          Underline="false"/>
        </MudButton>
        <AuthorizeView Policy="Admin">
            <MudButton Variant="Variant.Filled" Size="Size.Medium" OnClick="@OpenCreateDialog">
                Create New Event
            </MudButton>
        </AuthorizeView>
    </MudStack>

    <MudTable T="Event"
              Items="_events"
              Filter="FilterEvents"
              Hover="true"
              Dense="true"
              Loading="_loading"
              RowClass="cursor-pointer"
              OnRowClick="OnRowClick">
        <ColGroup>
            <col style="width: 160px;"/>
        </ColGroup>
        <HeaderContent>
            <MudTh>Events</MudTh>
            <MudTh/>
        </HeaderContent>

        <RowTemplate>
            <MudTd Class="d-flex align-center pa-3">
                <MudImage Class="rounded"
                          Src="@PlaceholderImageExtensions.GetImageUrl($"event-{context.Id}")"
                          Width="120"
                          Height="68"
                          ObjectFit="ObjectFit.Cover"/>
            </MudTd>
            <MudTd DataLabel="Name">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h5">@context.Name</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @context.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        <span class="mud-text-secondary">(@context.Date.ToLocalTime().TimeRelative())</span>
                    </MudText>
                </MudStack>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText>No events found.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudStack>

@code {
    private List<Event> _events = [];
    private bool _loading;
    private string? _search;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync() {
        _loading = true;
        try {
            _events = await EventService.GetAllAsync();
        } finally {
            _loading = false;
        }
    }

    private void OnRowClick(TableRowClickEventArgs<Event> args) {
        if (_loading) return;
        NavigationManager.NavigateTo($"/events/{args.Item?.Id}");
    }

    private bool FilterEvents(Event ev) {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var term = _search.Trim();
        return ev.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
               (ev.Description?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private async Task OpenCreateDialog() {
        var dialog = await DialogService.ShowAsync<EventUpsertDialog>("");
        var result = await dialog.Result;
        if (!(result?.Canceled ?? true)) await ReloadAsync();
    }

}
