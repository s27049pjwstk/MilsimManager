@page "/events/{EventId:int}"
@attribute [Authorize(Policy = "Active")]
@inject NavigationManager NavigationManager
@inject IEventService EventService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IErrorHandler ErrorHandler

@if (_event is null) {
    <MudStack Class="pt-16" AlignItems="AlignItems.Center" Justify="Justify.Center">
        <MudProgressCircular Indeterminate="true"/>
    </MudStack>
} else {
    <MudStack Spacing="3">
        <MudImage Elevation="2" Class="rounded" Src="@PlaceholderImageExtensions.GetImageUrl($"event-{EventId}")" Style="width: 100%" Height="240" ObjectFit="ObjectFit.Cover"/>
        <MudGrid>
            <MudItem xs="12" lg="6">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Start">
                        <MudStack Class="flex-grow-1" Spacing="0" Justify="Justify.FlexStart">
                            <MudStack AlignItems="AlignItems.Center" Row="true">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h5">@_event.Name</MudText>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        @_event.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        <span class="mud-text-secondary">(@_event.Date.ToLocalTime().TimeRelative())</span>
                                    </MudText>
                                </MudStack>
                                <MudSpacer/>
                                <MudStack Row="true" Spacing="2">
                                    <MudButton Variant="Variant.Filled" OnClick="@ToggleAttendAsync" Disabled="@IsPastEvent">
                                        @(_isAttending ? "Leave" : "I'm Attending")
                                    </MudButton>
                                    <AuthorizeView Policy="Admin">
                                        <MudIconButton Class="pa-2" Icon="@Icons.Material.Filled.Edit" OnClick="@OpenEditDialog"/>
                                    </AuthorizeView>
                                </MudStack>
                            </MudStack>

                            <MudDivider Class="my-2" Light="true"/>

                            <MudText Typo="Typo.body1">@(_event.Description ?? "No event description.")</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="6">
                <MudTable T="UserAttendance"
                          Items="@GetAttendees()"
                          Hover="true"
                          RowClass="cursor-pointer"
                          OnRowClick="OnRowClick">
                    <ColGroup>
                        <col style="width: 20%;"/>
                        <col style="width: 28%;"/>
                        <col style="width: 28%;"/>
                        <col style="width: 24%;"/>
                    </ColGroup>
                    <HeaderContent>
                        <MudTh><b>Rank</b></MudTh>
                        <MudTh><b>Name</b></MudTh>
                        <MudTh><b>Unit</b></MudTh>
                        <MudTh><b>Position</b></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Rank">@(context.User.Rank?.Abbreviation ?? context.User.Rank?.Name)</MudTd>
                        <MudTd DataLabel="Name">@context.User.Name</MudTd>
                        <MudTd DataLabel="Unit">@(context.User.Unit?.Name ?? "Unassigned")</MudTd>
                        <MudTd DataLabel="Position">@(context.User.UnitRole)</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Class="pa-4 mud-text-secondary">None</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudItem>
        </MudGrid>
    </MudStack>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    [Parameter]
    public int EventId { get; set; }

    private Event? _event;
    private bool _noEvent;
    private int? _currentUserId;
    private bool _isAttending;
    private bool IsPastEvent => _event is not null && _event.Date <= DateTime.UtcNow;

    protected override async Task OnParametersSetAsync() {
        var authState = await AuthenticationStateTask;
        _currentUserId = int.TryParse(authState.User.FindFirstValue("auth_UserId"), out var userId) ? userId : null;

        _event = await EventService.GetByIdAsync(EventId);
        if (_event is null) {
            _noEvent = true;
            return;
        }

        _isAttending = _currentUserId is not null &&
                       _event.UserAttendances.Any(ua => ua.UserId == _currentUserId.Value);
    }

    private void OnRowClick(TableRowClickEventArgs<UserAttendance> args) {
        NavigationManager.NavigateTo($"/users/{args.Item?.UserId}");
    }

    private IEnumerable<UserAttendance> GetAttendees() {
        if (_event is null) return [];
        return _event.UserAttendances
            .OrderBy(ua => ua.User.Unit?.Name)
            .ThenBy(ua => ua.User.Rank?.SortOrder)
            .ThenBy(ua => ua.User.Name);
    }

    private async Task ToggleAttendAsync() {
        if (_event is null || _currentUserId is null || IsPastEvent) return;

        try {
            if (_isAttending) {
                await EventService.UnattendAsync(_event.Id, _currentUserId.Value);
                Snackbar.Add("You have left the event", Severity.Success);
            } else {
                await EventService.AttendAsync(_event.Id, _currentUserId.Value);
                Snackbar.Add("You are attending this event", Severity.Success);
            }
            _event = await EventService.GetByIdAsync(EventId);
            _isAttending = _event?.UserAttendances.Any(ua => ua.UserId == _currentUserId.Value) ?? false;
        } catch (Exception ex) {
            ErrorHandler.HandleException(ex, "Failed to update attendance");
        }
    }

    private async Task OpenEditDialog() {
        if (_event is null) return;
        var dialog = await DialogService.ShowAsync<EventUpsertDialog>("", new DialogParameters { ["Event"] = _event });
        var result = await dialog.Result;
        if (!(result?.Canceled ?? true)) {
            if (result.Data is EventUpsertDialog.Result.Deleted) {
                NavigationManager.NavigateTo("/events");
            } else {
                _event = await EventService.GetByIdAsync(EventId);
            }
        }
    }

    protected override void OnAfterRender(bool firstRender) {
        if (!_noEvent) return;
        _noEvent = false;
        Snackbar.Add("Event does not exist", Severity.Error);
        NavigationManager.NavigateTo("/events", false, true);
    }

}
